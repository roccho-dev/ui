{
  "schema": "artifact-capability-declaration/2",
  "id": "render.decision-packet",
  "version": "1",
  "engine": {
    "kind": "esm",
    "file": "engine.mjs"
  },
  "accepts": {
    "intents": ["render"],
    "minInputs": 1,
    "maxInputs": 1,
    "shapes": ["blob"],
    "mediaTypes": ["application/vnd.roccho.decision-packet+json"],
    "schemas": ["decision-packet/1"]
  },
  "limits": {
    "maxInputBytes": 1048576,
    "maxTotalBytes": 1048576,
    "maxEntries": 1,
    "maxEngineBytes": 32768
  },
  "provides": ["render.decision-packet"],
  "produces": ["decision-packet-render-receipt/1"],
  "requires": {
    "features": ["dom", "fetch"],
    "services": ["ui.package.execute"],
    "runtimes": ["browser"]
  },
  "fixtures": {
    "pass": ["fixtures/public.pass.json"],
    "destructive": [
      "fixtures/private.destructive.json",
      "fixtures/malformed.destructive.json",
      "fixtures/tampered.destructive.json"
    ]
  }
}
