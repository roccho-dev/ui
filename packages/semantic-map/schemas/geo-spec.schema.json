{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-map.local/schemas/geo-spec.schema.json",
  "title": "Semantic Map GeoSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "crs", "bbox", "source", "features"],
  "properties": {
    "schema": {"const": "semantic-map-geo-spec/1"},
    "type": {"const": "FeatureCollection"},
    "crs": {"const": "OGC:CRS84"},
    "bbox": {"$ref": "#/$defs/bbox"},
    "source": {"$ref": "#/$defs/source"},
    "features": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/longitude"},
        {"$ref": "#/$defs/latitude"}
      ],
      "items": false
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/longitude"},
        {"$ref": "#/$defs/latitude"},
        {"$ref": "#/$defs/longitude"},
        {"$ref": "#/$defs/latitude"}
      ],
      "items": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "license", "attribution"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "license": {"type": "string", "maxLength": 120},
        "attribution": {"type": "string", "maxLength": 500}
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFeatureId", "derivation", "accuracyMeters"],
      "properties": {
        "sourceFeatureId": {"type": "string", "minLength": 1, "maxLength": 240},
        "derivation": {"enum": ["source", "centroid", "bounds"]},
        "accuracyMeters": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        }
      }
    },
    "pointGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {"$ref": "#/$defs/position"}
      }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {"$ref": "#/$defs/position"}
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string", "minLength": 1, "maxLength": 240},
        "geometry": {
          "oneOf": [
            {"$ref": "#/$defs/pointGeometry"},
            {"$ref": "#/$defs/polygonGeometry"}
          ]
        },
        "properties": {"$ref": "#/$defs/properties"}
      }
    }
  }
}
